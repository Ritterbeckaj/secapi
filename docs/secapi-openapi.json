  },
  "paths": {
    "/api/v1/password-iq/strength": {
      "get": {
        "tags": [
          "password-iq"
        ],
        "summary": "Score a password's strength (local only, never transmitted)",
        "operationId": "strength_api_v1_password_iq_strength_get",
        "parameters": [
          {
            "name": "password",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "description": "Password to score",
              "title": "Password"
            },
            "description": "Password to score"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "title": "Response Strength Api V1 Password Iq Strength Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/password-iq/breach": {
      "post": {
        "tags": [
          "password-iq"
        ],
        "summary": "k-anonymity breach lookup (HIBP range)",
        "description": "Check if a password has appeared in a known breach.\n\nThe password travels in the request body (never in URLs/logs). Implements\nk-anonymity: only the first 5 chars of the SHA-1 hash leave the machine.",
        "operationId": "breach_api_v1_password_iq_breach_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "title": "Response Breach Api V1 Password Iq Breach Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
