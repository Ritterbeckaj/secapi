{
  "openapi": "3.1.0",
  "info": {
    "title": "SecAPI \u2014 5 Cybersecurity REST Services",
    "description": "Five RESTful APIs that solve common cybersecurity problems:\n1. Password & breach intelligence\n2. CVE / dependency scanning\n3. IOC / indicator enrichment\n4. Threat log correlation & alerting\n5. Document / malware static analysis",
